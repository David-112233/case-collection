    "path": "input.json",
    "note": "用户 2026-11-17 微调定稿；Claude 只统一了“平铺/悬浮”用词"
  },
  "output_contract_ref": "scripts/eval_rules_generation/preparation/output_contract_v2.json",
  "scoring_policy_ref": "scripts/eval_rules_generation/preparation/evaluation_policy_v2.json#/scoring_policy",
  "source_policy": {
    "requirements": "input.json only; no DEC-037 common-sense condition added; business_background supplies context only",
    "gt": "ground_truth.html = source.html minus CodePen external script, reset stylesheet inlined; GT only for binding/self-test, never a requirement source",
    "model_outputs": "No model output read when drafting these rules"
  },
  "render_baseline": {
    "status": "NOT_FROZEN",
    "states": [
      "desktop"
    ],
    "viewports": {
      "desktop": [
        1280,
        900
      ]
    },
    "note": "input 只要求桌面宽屏；单一桌面视口采证，不考察其他宽度。",
    "resources": "JS、外部图片允许。记录 8 张图片加载结果；评测网络导致加载失败记 UNRESOLVED，不判模型 FAIL。"
  },
  "member_policy": {
    "group_identity": "两组按可见位置区分：上方正面平铺的四张为悬浮组，下方墙角场景中的四张为斜靠组；不依赖 DOM 顺序或类名。",
    "member_order": "组内第 N 张按可见位置从左到右确定；哪张图在哪个位置只由 SR-02/SR-03 的地址条件负责，其余条件只按位置判断。",
    "pairs": "相邻关系按三对（1-2、2-3、3-4）逐对计。"
  },
  "granularity_policy": {
    "members": "并列成员逐个成条：每张海报的地址、替代文字、比例、正面展示、无投影、立地面、靠墙、厚度、投影、表面光影各一条；相邻关系三对各一条。",
    "aggregate": "数量、整组居中、同宽、等距、两组大小比较、两组空白是整组性质，各一条。",
    "same_fact": "同一事实只放一条：顺序错误由位置-地址条件负责，替代文字按图片身份核对；“正面展示”与“不倾斜”合为一条。",
    "scoring_merge": "计分沿用 R02 case-213 的并列失败合并裁定（用户 2026-11-17 确认用于 case-227）：同一检查模板在并列成员上、由同一处实现造成的失败合为一组，按整组影响只判一档；流水线逐条分留档。"
  },
  "measure_policy": {
    "program_first": "DOM、URL、几何事实由程序判；程序不确定时交回 Judge，不判 FAIL。",
    "judge": "墙角、靠墙姿态、厚度、投影、表面光影是定性视觉条件，交 Judge；规则写出最低判定标准，不预设数值阈值。",
    "qualitative_words": "“略大”“大致居中”“窄缝”“明显空白”不设数值上下限；程序只给测量值，边界情况由 Judge 判断。"
  },
  "quality_gate": [
    {
      "id": "G1",
      "description": "HTML forms a valid evaluable DOM; parser/environment failure alone is not model fatal failure.",
      "source": "project_output_contract"
    },
