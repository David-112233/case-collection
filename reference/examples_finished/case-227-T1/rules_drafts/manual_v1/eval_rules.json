      "id": "G2",
      "description": "JS is allowed by the shared v2 policy; no blanket script/event-attribute violation.",
      "source": "project_output_contract"
    },
    {
      "id": "G3",
      "description": "External fonts, font stylesheets, images and ordinary links are allowed; resource availability is checked separately.",
      "source": "project_output_contract"
    },
    {
      "id": "G4",
      "description": "One complete HTML; page CSS embedded in head/style or style attributes; required JS embedded.",
      "source": "project_output_contract"
    },
    {
      "id": "G5",
      "description": "input.forbidden is empty; no case-specific prohibition is invented.",
      "source": "input.forbidden"
    }
  ],
